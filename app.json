{
  "expo": {
    "name": "Fisgados",
    "slug": "fisgados",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fisgados",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.fisgados.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B45D8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fisgados.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7FF",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071827"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Fisgados abre suas fotos para você registrar uma captura já fotografada."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Fisgados usa a câmera para você fotografar a captura."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Fisgados registra onde você pescou. A coordenada exata nunca é compartilhada com ninguém."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
