{
  "name": "fisgados",
  "version": "0.1.0",
  "private": true,
  "description": "Fisgados — álbum de capturas para pescadores do Sul",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "tsx scripts/test-domain.mts",
    "typecheck": "tsc --noEmit",
    "catalog:build": "tsx scripts/build-catalog.mts",
    "catalog:inspect": "tsx scripts/inspect-fishbase.mts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.15"
  },
  "comment": "overrides: o nativewind declara peer de react-native mais novo que o do SDK 54 e o npm instala uma cópia aninhada. Build nativo só aceita uma versão de cada módulo nativo, então forçamos as do SDK.",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.10",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "hyparquet": "^1.10.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  }
}
