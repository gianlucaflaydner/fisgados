{
  "name": "fisgados",
  "version": "0.1.0",
  "private": true,
  "description": "Fisgados — álbum de capturas para pescadores do Sul",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "tsx scripts/test-domain.mts",
    "typecheck": "tsc --noEmit",
    "catalog:build": "tsx scripts/build-catalog.mts",
    "catalog:inspect": "tsx scripts/inspect-fishbase.mts",
    "db:generate": "drizzle-kit generate",
    "photos:fetch": "tsx scripts/fetch-photos.mts",
    "photos:prepare": "tsx scripts/prepare-photos.mts",
    "photos:apply": "tsx scripts/apply-photo-choices.mts",
    "nuvem:check": "tsx scripts/check-cloud.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "drizzle-orm": "^0.45.2",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "comment": "overrides: o nativewind declara peer de react-native diferente do que o SDK usa e o npm instala uma cópia aninhada. Build nativo só aceita uma versão de cada módulo nativo, então forçamos as do SDK. Ao trocar de SDK, atualizar para as versões de node_modules/expo/bundledNativeModules.json.",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.4",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "hyparquet": "^1.10.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
