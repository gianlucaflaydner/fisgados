 * └─────────────────────────────────────────────────────────────────────────────────┘
 */

import type { AlbumId, MeasureAxis, Rarity } from '../../src/catalog/types.ts';

/**
 * Nomes da linha de insígnia (PRD 11.6). Espécie lendária não tem bronze nem prata — a
 * primeira captura já entrega o ouro —, então esses dois são opcionais e o build força null.
 */
export interface CuratedBadges {
  bronze?: string;
  prata?: string;
  ouro: string;
  platina: string;
  diamante: string;
}

export interface CuratedSpecies {
  id: string;
  /** Em que álbuns a espécie aparece. A **posição** na grade vem de ALBUM_LAYOUT, abaixo. */
  albums: AlbumId[];
  commonName: string;
  aliases: string[];
  /** Nome aceito hoje. É o que aparece na ficha da espécie. */
  scientificName: string;
  /**
   * Nome sob o qual o FishBase ainda arquiva a espécie, quando difere do aceito.
   * Só para buscar coeficiente — nunca é exibido. Use quando uma revisão taxonômica recente
   * ainda não chegou ao snapshot, e registre o motivo em comentário.
   */
  fishbaseName?: string;
  /**
   * Congênere de quem emprestar a relação comprimento-peso, quando o FishBase não tem estudo
   * em TL para a espécie. Só para peixe de porte relevante — para lambari, não estimar peso é
   * melhor que estimar mal. O empréstimo é registrado no JSON e aparece na ficha.
   */
  fishbaseWeightProxy?: string;
  /**
   * Variedade, quando a carta é uma linhagem e não um táxon. Duas cartas podem compartilhar
   * `scientificName` desde que ambas declarem `variety` — é o que libera carpa-espelho e
   * carpa-colorida ao lado da carpa-húngara.
   */
  variety?: string;
  rarity: Rarity;
  /** Padrão `comprimento`. Só arraias verdadeiras usam `largura` (do disco). */
  measure?: MeasureAxis;
  minLengthCm: number;
  avgLengthCm: number;
  maxLengthCm: number;
  habitat: string[];
  fact: string;
  visuallySimilarTo: string[];
  /** Híbrido de pesqueiro: sem entrada no FishBase, nunca terá coeficiente próprio. */
  hybrid?: boolean;
  /** Ausente → o build aplica a regra de fallback do PRD 11.6 e marca como não curado. */
  badges?: CuratedBadges;
}

